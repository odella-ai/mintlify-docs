+// Returns true if `targetPath` is `dir` itself or lives somewhere underneath it.
+// Both arguments are expected to be absolute paths.
+function isInsideDirectory (dir, targetPath) {
+  const relative = path.relative(dir, targetPath)
+  if (relative === '') return true
+  // A leading `..` segment escapes `dir`; an absolute result means a different
+  // Windows drive, which is out of bounds as well.
+  return !relative.split(path.sep).includes('..') && !path.isAbsolute(relative)
+}
